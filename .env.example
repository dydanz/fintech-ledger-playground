# Copy to .env and change before running anywhere but your laptop.
POSTGRES_USER=auth
POSTGRES_PASSWORD=auth_dev_password
POSTGRES_DB=auth
REDIS_PASSWORD=redis_dev_password
BCRYPT_COST=12
LOG_LEVEL=info
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ledger-api internal callers: client_id:sha256(token):operations;...
# Dev tokens (for scripts/smoke-ledger.sh): dev-onboarding-token, dev-payments-token, dev-ops-token, dev-fraud-token (fraud-engine: freeze only).
# Generate a hash with: printf '%s' "$TOKEN" | shasum -a 256
LEDGER_CLIENTS=onboarding:a8c31043ceb39b82f03c6095246e32adf5212405f8120dfba3a0da352ba9b933:account_open,read;payments:8d1ae9dffc3b7a38a480abbc728a279204e08ea8d60189b01cbee0fef1732bfa:credit,debit,read;ops:9d121d994c8c0ac8cc7786f5c0c775588c389b87416c38dd89acdefde3757d21:account_open,credit,debit,void,freeze,unfreeze,read;fraud-engine:3bdbcf9e9cfbca308c91ab7b78bc6a1738f5ab8c13241d00ecb6371a0d10630d:freeze
LEDGER_OVERDRAFT_CLIENTS=ops
LEDGER_CURRENCIES=IDR

# Archiver (ledger-worker, TRD §7.8) and its local write-once store (archive-store).
ARCHIVE_S3_ACCESS_KEY=archive-dev
ARCHIVE_S3_SECRET_KEY=archive_dev_secret
# Account ids on legal hold (comma-separated), or * to hold everything.
LEDGER_LEGAL_HOLD=
