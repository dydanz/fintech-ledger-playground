{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-default-branch.sh\"",
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "Checking branch protection"
          }
        ]
      }
    ]
  }
}
