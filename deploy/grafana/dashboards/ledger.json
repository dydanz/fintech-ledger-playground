{
  "uid": "ledger-overview",
  "title": "ledger overview",
  "schemaVersion": 39,
  "version": 3,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "10s",
  "tags": [
    "ledger"
  ],
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "Ledger operations/s by event and outcome",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (event, outcome) (rate({service=\"ledger-api\"} | json | event=~\"ledger\\\\.(credit|debit|void|account_open)\" [1m]))",
          "legendFormat": "{{event}} {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Success ratio, NFR-5 (target ≥ 99.99%)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "1 - ((sum(count_over_time({service=\"ledger-api\"} | json | message=\"http_request\" | method=\"POST\" | route=~\"/internal/v1/.*\" | status >= 500 [5m])) or vector(0)) + (sum(count_over_time({service=\"ledger-worker\"} | json | event=\"ledger.recover\" | reason=\"processing_timeout\" [5m])) or vector(0))) / sum(count_over_time({service=\"ledger-api\"} | json | message=\"http_request\" | method=\"POST\" | route=~\"/internal/v1/.*\" | status != 400 | status != 401 | status != 403 [5m]))",
          "legendFormat": "success ratio"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0.99,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.9999
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "description": "1 − (5xx on mutating /internal/v1 requests + transactions FAILED processing_timeout) / valid mutating requests (not 400/401/403), over 5 minutes (TRD §11, NFR-5). Business failures such as insufficient_funds count as successes.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Errors: failure and partial by event and reason (should be ~0)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (event, outcome, reason) (count_over_time({service=~\"ledger-api|ledger-worker|fraud-engine\", level=\"error\"} | json | event=~\"ledger\\\\..+\" [5m]))",
          "legendFormat": "{{event}} {{outcome}} {{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Business denials by reason",
