{
  "uid": "money-out-overview",
  "title": "money-out overview",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "10s",
  "tags": [
    "money-out"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Commands received by outcome and reason (transfer.receive)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (outcome, reason) (count_over_time({service=\"money-out-middleware\"} | json | event=\"transfer.receive\" [5m]))",
          "legendFormat": "{{outcome}} {{reason}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Errors: commands not stored (transfer.receive failure, should be 0)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (reason) (count_over_time({service=\"money-out-middleware\"} | json | event=\"transfer.receive\" | outcome=\"failure\" [5m]))",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "State changes by target state (transfer.state_change)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (to_state) (count_over_time({service=\"money-out-middleware\"} | json | event=\"transfer.state_change\" [5m]))",
          "legendFormat": "{{to_state}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Outbox lag (ms) and pending rows",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "max(max_over_time({service=\"money-out-middleware\"} | json | event=\"outbox.lag\" | unwrap lag_ms [1m]))",
          "legendFormat": "lag_ms"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Kafka and Postgres trouble (dependency.call, outbox.publish)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (event, operation, reason) (count_over_time({service=\"money-out-middleware\"} | json | event=~\"dependency.call|outbox.publish\" [5m]))",
          "legendFormat": "{{event}} {{operation}} {{reason}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Ops API rejections by reason (transfer.client_auth)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
