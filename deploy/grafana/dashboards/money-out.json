        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (reason) (count_over_time({service=\"money-out-middleware\"} | json | event=\"transfer.client_auth\" [5m]))",
          "legendFormat": "{{reason}}"
        }
